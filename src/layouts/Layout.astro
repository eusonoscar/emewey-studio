---
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";

interface Props {
  title: string;
}

const { title } = Astro.props;

const description =
  "Estudio de grabación profesional especializado en grabación, mezcla y mastering.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title} | Emewey Studio</title>
  </head>
  <body>
    <Navbar />
    <slot />
  </body>
</html>
