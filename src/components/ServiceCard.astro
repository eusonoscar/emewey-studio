---
interface Props {
  title: string;
  image: string;
}

const { title, image } = Astro.props;
---

<div class="card">
  <img src={image} alt={title} />
  <h3>{title}</h3>
</div>

<style>
  .card {
    position: relative;
    overflow: hidden;
    cursor: pointer;
    border: 1px solid black;
    height: 100%;
    min-height: 280px;
  }

  .card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.7s ease;
  }

  .card:hover img {
    transform: scale(1.1);
  }

  .card h3 {
    position: absolute;
    bottom: 1rem;
    left: 1rem;
    color: #ffffff;
    font-size: 1.5rem;
    margin: 0;
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.6);
  }
</style>
